#!/bin/bash
set -e
BIN="/opt/cfdata/cfdata-linux-amd64"
PID_FILE="/var/run/cfdata.pid"
case "$1" in
  start)
    nohup "$BIN" >> /var/log/cfdata.log 2>&1 &
    echo $! > "$PID_FILE"
    exit 0
    ;;
  stop)
    kill "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null || true
    rm -f "$PID_FILE"
    exit 0
    ;;
  status)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then exit 0; else exit 3; fi
    ;;
  *)
    exit 1
    ;;
esac
