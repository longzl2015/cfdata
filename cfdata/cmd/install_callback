#!/bin/bash
set -e

APP_ROOT="/var/apps/cfdata"
TARGET_DIR="$APP_ROOT/target"
VAR_DIR="$APP_ROOT/var"
CONFIG_FILE="$VAR_DIR/cfdata-config.json"

# 从环境变量获取端口（飞牛向导传参）
SERVICE_PORT="${TRIM_SERVICE_PORT:-13335}"

# 如果通过第一个参数传递
if [ -n "$1" ]; then
    SERVICE_PORT="$1"
fi

# 验证端口范围
if ! echo "$SERVICE_PORT" | grep -qE '^[0-9]+$' || [ "$SERVICE_PORT" -lt 1 ] || [ "$SERVICE_PORT" -gt 65535 ]; then
    SERVICE_PORT=13335
fi

# 生成配置文件
mkdir -p "$VAR_DIR"
cat > "$CONFIG_FILE" << EOF
{
  "port": $SERVICE_PORT,
  "installed": true,
  "installed_at": "$(date +%Y-%m-%dT%H:%M:%S)"
}
EOF

echo "[cfdata] 安装回调：配置文件已生成"
echo "[cfdata] 服务端口: $SERVICE_PORT"
echo "[cfdata] 配置文件: $CONFIG_FILE"
exit 0
