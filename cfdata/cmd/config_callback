#!/bin/bash
set -e

APP_ROOT="/var/apps/cfdata"
TARGET_DIR="$APP_ROOT/target"
VAR_DIR="$APP_ROOT/var"
CONFIG_FILE="$VAR_DIR/cfdata-config.json"

# 从环境变量获取端口
SERVICE_PORT="${TRIM_SERVICE_PORT:-8080}"
if [ -n "$1" ]; then
    SERVICE_PORT="$1"
fi

# 验证端口范围
if ! echo "$SERVICE_PORT" | grep -qE '^[0-9]+$' || [ "$SERVICE_PORT" -lt 1 ] || [ "$SERVICE_PORT" -gt 65535 ]; then
    SERVICE_PORT=8080
fi

# 更新配置文件
mkdir -p "$VAR_DIR"
cat > "$CONFIG_FILE" << EOF
{
  "port": $SERVICE_PORT,
  "installed": true,
  "updated_at": "$(date +%Y-%m-%dT%H:%M:%S)"
}
EOF

echo "[cfdata] 配置回调：端口已更新为 $SERVICE_PORT"
exit 0
