#!/bin/bash
set -e

APP_ROOT="/var/apps/cfdata"
TARGET_DIR="$APP_ROOT/target"
BIN="$TARGET_DIR/cfdata-linux-amd64"
VAR_DIR="$APP_ROOT/var"
CONFIG_FILE="$VAR_DIR/cfdata-config.json"
PID_FILE="$VAR_DIR/cfdata.pid"
LOG_FILE="$VAR_DIR/cfdata.log"

# 读取端口，默认 13335
SERVICE_PORT=13335
if [ -f "$CONFIG_FILE" ]; then
    SERVICE_PORT=$(grep -o '"port": [0-9]*' "$CONFIG_FILE" | grep -o '[0-9]*')
fi
[ -z "$SERVICE_PORT" ] && SERVICE_PORT=13335

# 确保 var 目录存在
mkdir -p "$VAR_DIR"

case "$1" in
    start)
        echo "[cfdata] 启动中，服务端口: $SERVICE_PORT ..."
        if [ -f "$PID_FILE" ]; then
            OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
                echo "[cfdata] 已在运行，PID=$OLD_PID"
                exit 0
            fi
            rm -f "$PID_FILE"
        fi

        if [ ! -f "$BIN" ]; then
            echo "[cfdata] 错误：二进制不存在 $BIN" >&2
            exit 1
        fi

        chmod +x "$BIN"
        nohup "$BIN" -port "$SERVICE_PORT" >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        sleep 2
        if kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "[cfdata] 启动成功，PID=$(cat "$PID_FILE")，端口: $SERVICE_PORT"
            exit 0
        else
            echo "[cfdata] 启动失败" >&2
            exit 1
        fi
        ;;
    stop)
        echo "[cfdata] 停止中..."
        if [ -f "$PID_FILE" ]; then
            PID=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                kill "$PID" 2>/dev/null || true
                sleep 1
                kill -9 "$PID" 2>/dev/null || true
            fi
            rm -f "$PID_FILE"
        fi
        pkill -f cfdata-linux-amd64 2>/dev/null || true
        echo "[cfdata] 已停止"
        exit 0
        ;;
    status)
        if [ -f "$PID_FILE" ]; then
            PID=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                exit 0
            fi
        fi
        exit 3
        ;;
    *)
        echo "用法: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
